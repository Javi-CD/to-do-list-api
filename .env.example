# *******************
# * Database Config *
# *******************
DATABASE_URL="postgresql://username:password@localhost:5432/todolist_db?schema=public"

# **************
# * JWT Config *
# **************
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# *****************
# * Server Config *
# *****************
PORT=3000
NODE_ENV=development

# ***************
# * CORS Config *
# ***************
CORS_ORIGIN="http://localhost:3001"

# ***********************
# * Default User Config *
# ***********************
DEFAULT_USER_EMAIL="admin@example.com"
DEFAULT_USER_PASSWORD="Admin123"
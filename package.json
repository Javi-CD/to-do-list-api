{
  "name": "todo-list-api",
  "version": "1.0.0",
  "description": "API Rest for application of to do list",
  "keywords": [
    "todo",
    "api",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Javier Pérez",
  "license": "MIT",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "npx prisma migrate dev",

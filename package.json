    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "morgan": "^1.10.1",
    "nodemon": "^3.0.2",
    "prisma": "^5.7.1"
  }
}
